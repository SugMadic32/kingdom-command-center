# ---- Required ----
# Cloud server only: your domain for HTTPS, e.g. gto-kingdom.duckdns.org (no https://)
SITE_DOMAIN=
# Cloud server only: database password used by docker-compose (letters and numbers)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://kc:change-me@localhost:5432/kingdom
APP_URL=http://localhost:5173          # public URL of the site (used in links and reminders)
NODE_ENV=development                   # set to production when deployed (enables secure cookies)
PORT=4000

# ---- Optional: browser push notifications ----
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- Optional: email notifications (HTTPS API; Railway Hobby blocks SMTP) ----
# EMAIL_PROVIDER is resend or brevo
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Kingdom Command Center

# ---- Optional: Discord bot (server-side only, never put these in the web app) ----
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=                      # your kingdom server; commands register instantly there

# Set to false if you run more than one API instance (only one should send reminders)
RUN_JOBS=true
SESSION_DAYS=30
